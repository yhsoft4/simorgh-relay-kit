# IRAN side (entry server). Dials OUT to the kharej server, so it keeps working even when the
# Iran IP is unreachable from abroad. Generated by BackPack's menu; this is only what the values look like.
# BackPack writes its own shared secret line into the real file. Never paste or commit that line.
[l3]
mode         = "dial"
addr         = "KHAREJ_IP:9000"
carrier      = "pck"
encap        = "gre"
iface        = "bp0"
local_ip     = "10.10.0.1/30"
peer_ip      = "10.10.0.2"
mtu          = 1400
preset       = "balance"
txqueuelen   = 1024
qdisc        = "fq_codel"
sockbuf      = 4194304
# ports users connect to on the Iran IP; each one is carried through the tunnel to the same port on kharej.
# "443=OTHER_IP:443" forwards one port to a different kharej address.
ports        = ["80", "8080", "8443", "2053", "2083", "2087", "3053"]
accept_udp   = true
